# CampusBite AI v2.0 — Optional Neon Free PostgreSQL Cloud Development Configuration
# IMPORTANT:
#   - Primary production database is self-hosted PostgreSQL on college-owned hardware (zero paid subscription).
#   - Neon Free is strictly an OPTIONAL development / staging convenience (subject to Neon Free storage ~0.5 GB
#     and monthly compute-hour caps — never assume unlimited storage or traffic on Neon Free).
#   - Switching between Neon Free and College PostgreSQL requires changing ONLY DATABASE_URL below.

ENVIRONMENT=development
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=false
SECRET_KEY=replace-with-at-least-32-random-characters-for-dev-env

# Paste your Neon Free connection string (pooled endpoint uses DB_USE_PGBOUNCER_TRANSACTION_POOL=true):
DATABASE_URL=postgresql+psycopg://neondb_owner:REPLACE_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/campusbite_dev?sslmode=require
DB_USE_PGBOUNCER_TRANSACTION_POOL=true

TEMP_RETENTION_DAYS=4
BACKUP_PRIMARY_DIR=backups/primary
BACKUP_SECONDARY_DIR=backups/secondary_offhost
