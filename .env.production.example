# Copy to .env on the server (never commit it). Replace every placeholder before launch.
APP_NAME=ACE Canteen
APP_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO
HTTPS_TERMINATED=true
PUBLIC_BASE_URL=https://canteen.your-college.edu

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
METRICS_TOKEN=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PICKUP_TOKEN_MINUTES=20
CHECKOUT_RESERVATION_MINUTES=15
ADMIN_REQUIRE_MFA=false

DATABASE_URL=postgresql+psycopg://ace_canteen:REPLACE_PASSWORD@db:5432/ace_canteen
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=false

POSTGRES_DB=ace_canteen
POSTGRES_USER=ace_canteen
POSTGRES_PASSWORD=
APP_PORT=8000

# Razorpay: verify sandbox end-to-end first (rzp_test_...), switch to live keys only after merchant KYC & webhook verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# Optional AI provider key (never exposed to browser or mobile clients)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:canteen@your-college.edu

# Optional S3-compatible object storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_URL=

# Email for password resets, verification & receipts
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_RECEIPTS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ACE Canteen <canteen@your-college.edu>"
SMTP_USE_SSL=false

# Canteen hours and pickup slots
CANTEEN_OPEN_TIME=09:00
CANTEEN_CLOSE_TIME=17:00
CANTEEN_TIMEZONE=Asia/Kolkata
CANTEEN_OPEN_DAYS=0,1,2,3,4,5
PICKUP_SLOT_MINUTES=15
PICKUP_SLOT_CAPACITY=20
PICKUP_MIN_LEAD_MINUTES=10
OVERDUE_PREPARATION_MINUTES=20
EMAIL_ORDER_READY=true

# Required in production for shared rate limiting
REDIS_URL=redis://redis:6379/0
