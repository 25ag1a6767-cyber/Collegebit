# Copy to mobile/.env for local development or point EAS environment variables here.
# Android Emulator reaches host machine at http://10.0.2.2:8000; iOS Simulator uses http://127.0.0.1:8000.
# Production builds must set an explicit HTTPS domain:
EXPO_PUBLIC_API_URL=https://canteen.your-college.edu
# Optional EAS Project ID for Expo push notifications in EAS builds:
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
