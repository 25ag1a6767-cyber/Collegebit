{
  "expo": {
    "name": "CollegeBits",
    "slug": "campusbite-ai",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "campusbite",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf9f5"
    },
    "android": {
      "package": "com.acecanteen.campus",
      "versionCode": 200,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.acecanteen.campus",
      "buildNumber": "200",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan QR tokens for order pickups.",
        "LSApplicationQueriesSchemes": [
          "upi",
          "phonepe",
          "paytmmp",
          "gpay",
          "tez",
          "bhim",
          "credpay"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": ""
    }
  }
}
