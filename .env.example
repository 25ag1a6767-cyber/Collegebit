APP_NAME=ACE Canteen
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Local SQLite for zero-setup development. Use PostgreSQL in staging and production:
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/ace_canteen
DATABASE_URL=sqlite:///./backend/ace_canteen.db
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=false
# Replace with a unique random string (>= 32 chars) before deployment.
SECRET_KEY=change-this-development-secret-before-deployment
ACCESS_TOKEN_MINUTES=100
REFRESH_TOKEN_DAYS=14
PICKUP_TOKEN_MINUTES=100
CHECKOUT_RESERVATION_MINUTES=100

# Razorpay TEST keys first (rzp_test_...). Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# Google Gemini API (optional). When unset, the AI menu assistant uses the deterministic verified-menu fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Web Push VAPID keys (for browser push notifications).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:canteen@example.edu

# Optional S3-compatible public base URL for uploaded menu images; defaults to local /assets/uploads storage in development.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_URL=

# Docker Compose PostgreSQL settings (use a long random password for deployment).
POSTGRES_DB=ace_canteen
POSTGRES_USER=ace_canteen
POSTGRES_PASSWORD=change-this-postgres-password-before-deployment
APP_PORT=8000

# --- Password reset, email verification & receipts (SMTP) ---
PUBLIC_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_RECEIPTS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# --- Canteen hours and pickup slots (leave times empty for "always open, no slots") ---
CANTEEN_OPEN_TIME=
CANTEEN_CLOSE_TIME=
CANTEEN_TIMEZONE=Asia/Kolkata
CANTEEN_OPEN_DAYS=0,1,2,3,4,5
PICKUP_SLOT_MINUTES=15
PICKUP_SLOT_CAPACITY=10
PICKUP_MIN_LEAD_MINUTES=10
OVERDUE_PREPARATION_MINUTES=20
EMAIL_ORDER_READY=true
# Shared rate limiting and cache across workers (required in production).
REDIS_URL=
